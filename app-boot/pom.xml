<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>co.tz.werelay</groupId>
        <artifactId>enterprise-app</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app-boot</artifactId>
    <packaging>jar</packaging>
    <name>app-boot</name>
    <description>The runnable Spring Boot artifact. Wires all modules together; carries the Dockerfile, actuator, and profile YAMLs.</description>

    <dependencies>
        <dependency>
            <groupId>co.tz.werelay</groupId>
            <artifactId>app-api</artifactId>
        </dependency>
        <dependency>
            <groupId>co.tz.werelay</groupId>
            <artifactId>app-config</artifactId>
        </dependency>
        <dependency>
            <groupId>co.tz.werelay</groupId>
            <artifactId>app-persistence</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Used by CustomerApiIntegrationTest — real Postgres in a container instead of H2.
             Version is managed by the testcontainers-bom imported in the root pom.xml. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>enterprise-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Embeds git.properties into this JAR's manifest — see root pom.xml pluginManagement -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
            </plugin>
            <!--
                Docker-backed integration tests (class name ending in *IT) run here, in the
                integration-test/verify phases — separate from plain unit tests (*Test),
                which Surefire already runs in the test phase without needing Docker.

                No Docker running locally? `mvn clean verify -DskipITs` skips this plugin
                and still runs everything else. CI (GitHub Actions ubuntu-latest runners
                ship Docker preinstalled) runs the full `mvn clean verify` with ITs included.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>